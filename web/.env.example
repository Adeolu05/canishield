# Web app on Vercel. Set these in Vercel → Project → Settings → Environment
# Variables (Production, and Preview if you use preview deployments).
# Placeholders only: never commit real values. Locally the web app reads the
# repo-root .env instead (see ../.env.example).

# Neon POOLED connection string (host contains "-pooler"), with sslmode=require.
# The DB client turns off prepared statements on the pooler and keeps at most
# 3 connections per function instance.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Public origin, no trailing slash. Used in share links and social previews.
# If unset on Vercel, the project's production domain is used.
ZECPROOF_SITE_URL=https://your-domain.example

# Mainnet "Run a test". Leave UNSET in production until the mainnet worker is
# live; anything other than "yes" keeps it off. Testnet tests are always on.
# ZECPROOF_ENABLE_MAINNET_TESTS=yes

# /report/form-check (logging withdrawal form checks). There is no login, so
# leave UNSET on any public deployment. It also can't store screenshots on
# Vercel (read-only filesystem): log form checks locally and commit them.
# ZECPROOF_ENABLE_FORM_CHECKS=yes

# Scanner worker on Railway (worker/Dockerfile). Set these in Railway → service
# → Variables. Placeholders only: never commit real values.
#
# The worker reads only the database URL and network settings. It holds viewing
# keys only (from the key pool in the database), never seeds: the image pins
# ZECPROOF_KEY_SOURCE=pool and the worker refuses to start if
# WORKER_TEST_MNEMONIC is set. Don't set either of them here.

# Neon DIRECT connection string (host WITHOUT "-pooler"), with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# One worker = one network. testnet unless both mainnet settings are given.
ZECPROOF_NETWORK=testnet

# Optional: endpoint lists, primary first, comma-separated. Defaults are built in.
# ZECPROOF_TESTNET_GRPC_URLS=https://testnet.zec.rocks:443,https://zaino.testnet.unsafe.zec.rocks:443

# Optional: how long a test waits for a payment (hours).
# TEST_TTL_HOURS=48

# --- Mainnet worker (a second Railway service) --------------------------------
# Needs BOTH settings; otherwise it refuses to start.
# ZECPROOF_NETWORK=mainnet
# ZECPROOF_ALLOW_MAINNET=yes
# ZECPROOF_MAINNET_GRPC_URLS=https://na.zec.rocks:443,https://eu.zec.rocks:443,https://zaino.unsafe.zec.rocks:443

# Optional testnet rehearsal of the mainnet rules:
# ZECPROOF_REQUIRED_CONFIRMATIONS=10
# ZECPROOF_EXPLORER_CHECK=on

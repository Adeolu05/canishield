# Copy to .env (gitignored). Testnet only.

# Local dev Postgres from docker-compose.yml
DATABASE_URL=postgres://zecproof:zecproof@localhost:5432/zecproof

# Testnet lightwalletd / Zaino endpoint. The worker refuses any endpoint
# that does not report chainName "test".
ZECPROOF_GRPC_URL=https://testnet.zec.rocks:443

# Worker master seed for throwaway TESTNET test keys. Each test gets its own
# ZIP-32 account (and therefore its own publishable viewing key).
# Generate one with: npm run new-mnemonic -w worker
WORKER_TEST_MNEMONIC=

# How long a test waits for a payment before it expires.
TEST_TTL_HOURS=48

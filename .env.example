# Local development. Copy to .env (gitignored); never commit real values.
# Hosted deployments set their variables in the provider's dashboard instead:
#   web (Vercel):     web/.env.example
#   worker (Railway): worker/.env.example
# Testnet by default; mainnet is off unless enabled below.

# Local dev Postgres from docker-compose.yml
DATABASE_URL=postgres://zecproof:zecproof@localhost:5432/zecproof

# Network this worker serves. One worker process = one network.
ZECPROOF_NETWORK=testnet

# Testnet lightwalletd / Zaino endpoints, primary first, comma-separated. The
# worker uses the first that answers each cycle, and stops if an endpoint it
# reaches reports the wrong chain. Each network has its own variable.
ZECPROOF_TESTNET_GRPC_URLS=https://testnet.zec.rocks:443,https://zaino.testnet.unsafe.zec.rocks:443

# TESTNET DEV MODE ONLY: worker seed for throwaway testnet keys, one ZIP-32
# account per test. Leave empty to use the key pool instead. The mainnet worker,
# and any worker using the key pool (including the Docker image), refuses to
# start if this is set. Never set it on a hosted worker.
# Generate one with: npm run new-mnemonic -w worker
WORKER_TEST_MNEMONIC=

# How long a test waits for a payment before it expires.
TEST_TTL_HOURS=48

# --- Mainnet (off by default) -------------------------------------------------
# A mainnet worker needs BOTH of these, uses only the offline key pool
# (keygen/ + npm run pool:import -w worker), and requires 10 confirmations plus
# an independent explorer check (ZecBlock, then Blockchair) before "verified".
# ZECPROOF_NETWORK=mainnet
# ZECPROOF_ALLOW_MAINNET=yes
# ZECPROOF_MAINNET_GRPC_URLS=https://na.zec.rocks:443,https://eu.zec.rocks:443,https://zaino.unsafe.zec.rocks:443

# --- Web ----------------------------------------------------------------------
# Canonical origin for share links and social previews.
# ZECPROOF_SITE_URL=http://localhost:3000

# Allow creating mainnet tests on the board at "/". Off unless "yes".
# ZECPROOF_ENABLE_MAINNET_TESTS=yes

# /report/form-check is always on in development (next dev). In a production
# build it is off unless "yes".
# ZECPROOF_ENABLE_FORM_CHECKS=yes

# Testnet rehearsal of the mainnet rules:
# ZECPROOF_REQUIRED_CONFIRMATIONS=10
# ZECPROOF_EXPLORER_CHECK=on

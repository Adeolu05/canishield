{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker/Dockerfile",
    "watchPatterns": [
      "worker/**",
      "packages/db/**",
      "packages/zcash/**",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false
  }
}

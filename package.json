{
  "name": "zecproof",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/db",
    "packages/zcash",
    "keygen",
    "worker",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @zecproof/db",
    "db:migrate": "npm run migrate -w @zecproof/db",
    "db:seed": "npm run seed -w @zecproof/db",
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run typecheck -w @zecproof/db -w @zecproof/zcash -w keygen -w worker && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w @zecproof/db -w @zecproof/zcash -w keygen -w worker -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
